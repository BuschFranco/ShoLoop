# Godot 4+ specific ignores
.godot/
/android/

# .NET / C# build artifacts
bin/
obj/
.vs/
*.user

# Stale local backups (e.g. ShooterLoop.csproj.old)
*.old

# Local export outputs (Godot's Export dialog writes these to the project root) — large binaries
# and a machine-specific preset config, neither belongs in source control.
/build/
/build-linux/
/build-android/
/ShooterLoop.apk
/ShooterLoop.exe
/ShooterLoop.console.exe
/ShooterLoop.pck
/ShooterLoop.x86_64
/ShooterLoop-linux-x86_64.tar.gz
/data_ShooterLoop_windows_x86_64/
/export_presets.cfg
/export_presets.cfg.bak

# Python bytecode from the tools/ scripts
__pycache__/
*.pyc

# Asset audition page: copies of assets that are already committed elsewhere, regenerated on demand
# by `build_assets.py --audition`. Committing it would double every sound in the repo.
/tools/audition/

# Claude Code session-local runtime state (PID/timestamp, not shared config)
.claude/scheduled_tasks.lock
