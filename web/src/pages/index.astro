---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<Base
	title="Infinitix — La ronda que nunca se corta"
	description="Infinitix es un shooter arcade de supervivencia: sobrevivís rondas, te hacés más fuerte, los demonios no paran de escalar. Sin conexión, sin compras, sin cuentas."
	lang="es"
	altHref={`${base}/en/`}
>
	<Header lang="es" esHref={`${base}/`} enHref={`${base}/en/`} />

	<main>
		<section class="hero">
			<h1>INFINITIX</h1>
			<p class="tagline">La ronda que nunca se corta</p>
			<p class="premise">
				No hay historia que termine porque la ronda no termina. Te subís a la arena, los
				demonios no paran de escalar, y la única salida es sobrevivir una más — y después
				otra. Infinitix es ese "una más" convertido en juego: cada ronda te hace más
				fuerte, cada ronda manda algo peor a buscarte, y no hay final feliz esperándote
				al otro lado. Solo el próximo récord.
			</p>
			<a class="cta" href="#" aria-disabled="true">Próximamente en Google Play</a>
		</section>

		<section class="features">
			<div class="feature">
				<h2>Disparo automático</h2>
				<p>Movete con el joystick, tu nave dispara sola al enemigo más cercano. Toda la
				atención va a esquivar, no a apuntar.</p>
			</div>
			<div class="feature">
				<h2>Cada ronda, más fuerte</h2>
				<p>Subís de nivel en plena partida y elegís mejoras: cadencia, alcance, daño,
				habilidades nuevas. Cada corrida arma una build distinta.</p>
			</div>
			<div class="feature">
				<h2>Elegí tu piloto</h2>
				<p>Un roster de personajes con perks propios — y la posibilidad de crear el tuyo
				con tu propia foto, guardado siempre en tu dispositivo.</p>
			</div>
		</section>
	</main>

	<Footer lang="es" />
</Base>

<style>
	.hero {
		padding-top: 64px;
		text-align: center;
	}

	.hero h1 {
		font-size: clamp(2.4rem, 8vw, 4rem);
		margin: 0;
		color: var(--cyan);
		letter-spacing: 0.04em;
		text-shadow: 0 0 24px rgba(125, 253, 254, 0.35);
	}

	.tagline {
		color: var(--magenta);
		font-weight: 600;
		margin-top: 6px;
	}

	.premise {
		max-width: 560px;
		margin: 24px auto 0;
		color: var(--text-dim);
	}

	.cta {
		display: inline-block;
		margin-top: 32px;
		padding: 14px 28px;
		border-radius: 10px;
		border: 2px solid var(--cyan);
		color: var(--cyan);
		text-decoration: none;
		font-weight: 700;
		opacity: 0.85;
		cursor: default;
	}

	.features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 24px;
		margin-top: 72px;
	}

	.feature {
		background: var(--panel);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 12px;
		padding: 20px;
	}

	.feature h2 {
		font-size: 1.05rem;
		color: var(--cyan);
		margin: 0 0 8px;
	}

	.feature p {
		margin: 0;
		color: var(--text-dim);
		font-size: 0.92rem;
	}
</style>
